# Copy these into Vercel: Project > Settings > Environment Variables.
# For local testing, copy this file to .env and fill it in.

# From developer.spotify.com > your app > Settings ("Client ID"). Not secret, but kept here so you never edit code.
SPOTIFY_CLIENT_ID=

# From console.anthropic.com > API Keys. SECRET.
ANTHROPIC_API_KEY=

# From getsongbpm.com/api (emailed to you). SECRET. Optional: without it, BPM shows as "approx."
GETSONGBPM_API_KEY=

# Your Spotify user ID (shown in the app under the menu once you log in). Only these accounts can use the AI.
# Comma-separated if more than one. Strongly recommended.
ALLOWED_SPOTIFY_USER_IDS=

# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low   (low = fastest; medium or high = more thoughtful but slower)
